{
  "name": "drillharmony-app",
  "version": "2.0.0",
  "private": true,
  "description": "DrillHarmony: калькуляторы и инструменты инженера ННБ для Android и iOS",
  "scripts": {
    "www": "cd .. && python3 build.py && python3 app/mk_app.py",
    "sync": "npm run www && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios",
    "assets": "npx capacitor-assets generate --assetPath resources --iconBackgroundColor \"#f2a541\" --iconBackgroundColorDark \"#f2a541\" --splashBackgroundColor \"#080d10\" --splashBackgroundColorDark \"#080d10\"",
    "setup": "node scripts/setup-native.mjs",
    "apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/clipboard": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/inappbrowser": "^4.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
