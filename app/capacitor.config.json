{
  "appId": "com.drillharmony.app",
  "appName": "DrillHarmony",
  "webDir": "www",
  "backgroundColor": "#080d10",
  "android": {
    "backgroundColor": "#080d10",
    "allowMixedContent": false
  },
  "ios": {
    "backgroundColor": "#080d10",
    "contentInset": "never",
    "scrollEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#080d10",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    }
  }
}
